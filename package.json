{
  "name": "chuck-live",
  "displayName": "ChucK Live",
  "description": "Live coding for ChucK: VM control, shred load/unload, and annotated knobs over OSC",
  "version": "0.3.59",
  "publisher": "chuck-live",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:chuck",
    "onView:chuckLive.control",
    "onView:chuckLive.sessionShreds",
    "onView:chuckLive.knobs",
    "onView:chuckLive.wiring",
    "onCommand:chuckLive.generateVoiceSample"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "chuck",
        "aliases": [
          "ChucK",
          "chuck"
        ],
        "extensions": [
          ".ck"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chuck",
        "scopeName": "source.chuck",
        "path": "./syntaxes/chuck.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[chuck]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": false
        },
        "editor.codeLens": true
      }
    },
    "commands": [
      {
        "command": "chuckLive.startVm",
        "title": "ChucK: Start VM",
        "icon": "$(play)"
      },
      {
        "command": "chuckLive.stopVm",
        "title": "ChucK: Stop VM",
        "icon": "$(debug-stop)"
      },
      {
        "command": "chuckLive.addShred",
        "title": "ChucK: Add Current File",
        "shortTitle": "Load",
        "icon": "$(add)"
      },
      {
        "command": "chuckLive.replaceShred",
        "title": "ChucK: Reload Shred",
        "shortTitle": "Reload",
        "icon": "$(sync)"
      },
      {
        "command": "chuckLive.runShred",
        "title": "ChucK: Load / Reload",
        "shortTitle": "Load",
        "icon": "$(run)"
      },
      {
        "command": "chuckLive.removeShred",
        "title": "ChucK: Remove Shred",
        "icon": "$(trash)"
      },
      {
        "command": "chuckLive.removeAll",
        "title": "ChucK: Remove All Shreds",
        "icon": "$(clear-all)"
      },
      {
        "command": "chuckLive.refreshStatus",
        "title": "ChucK: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "chuckLive.refreshKnobs",
        "title": "ChucK: Refresh Knobs",
        "icon": "$(refresh)"
      },
      {
        "command": "chuckLive.openRack",
        "title": "ChucK: Open Rack",
        "icon": "$(circuit-board)"
      },
      {
        "command": "chuckLive.openSequencer",
        "title": "ChucK: Open Sequencer",
        "icon": "$(grabber)"
      },
      {
        "command": "chuckLive.initProject",
        "title": "ChucK: Init Project Library",
        "icon": "$(folder-library)"
      },
      {
        "command": "chuckLive.initProjectForce",
        "title": "ChucK: Re-init Project Library (force)"
      },
      {
        "command": "chuckLive.importBundledPatterns",
        "title": "ChucK: Import Bundled Patterns",
        "icon": "$(cloud-download)"
      },
      {
        "command": "chuckLive.showSession",
        "title": "ChucK: Show Session (Shreds)",
        "icon": "$(list-unordered)"
      },
      {
        "command": "chuckLive.showWiring",
        "title": "ChucK: Show Mod Matrix",
        "icon": "$(git-merge)"
      },
      {
        "command": "chuckLive.generateVoiceSample",
        "title": "ChucK: Generate Voice Sample",
        "icon": "$(mic)"
      },
      {
        "command": "chuckLive.toggleFavorite",
        "title": "ChucK: Toggle Favorite",
        "shortTitle": "Favorite",
        "icon": "$(star)"
      },
      {
        "command": "chuckLive.loadFavorite",
        "title": "ChucK: Load Favorite",
        "shortTitle": "Load",
        "icon": "$(play)"
      },
      {
        "command": "chuckLive.reloadFavorite",
        "title": "ChucK: Reload Favorite",
        "shortTitle": "Reload",
        "icon": "$(sync)"
      },
      {
        "command": "chuckLive.removeFavorite",
        "title": "ChucK: Remove Favorite",
        "shortTitle": "Unfavorite",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "chuckLive.replaceShred",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "editorLangId == chuck"
      },
      {
        "command": "chuckLive.addShred",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorLangId == chuck"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chuckLive",
          "title": "ChucK Live",
          "icon": "media/chuck-icon.svg"
        },
        {
          "id": "chuckLiveSession",
          "title": "ChucK Session",
          "icon": "media/chuck-session-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "chuckLivePanel",
          "title": "ChucK Live",
          "icon": "media/chuck-icon.svg"
        }
      ]
    },
    "views": {
      "chuckLive": [
        {
          "type": "webview",
          "id": "chuckLive.knobs",
          "name": "Knobs"
        }
      ],
      "chuckLivePanel": [
        {
          "type": "webview",
          "id": "chuckLive.wiring",
          "name": "Mod Matrix"
        }
      ],
      "chuckLiveSession": [
        {
          "id": "chuckLive.control",
          "name": "Control"
        },
        {
          "id": "chuckLive.sessionShreds",
          "name": "Shreds"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "chuckLive.control",
        "contents": "Start the ChucK VM, then star `.ck` files from the editor to pin favorites here.\n\n[Start VM](command:chuckLive.startVm)\n\n[Init Project Library](command:chuckLive.initProject)"
      },
      {
        "view": "chuckLive.sessionShreds",
        "contents": "No shreds loaded yet.\n\n1. **Start VM** from **Control** above\n2. **Add Current File** (`Ctrl+Shift+.`) from a `.ck` editor\n3. **Reload** (`Ctrl+.`) or the inline sync icon to hot-swap a loaded shred\n4. Drag shreds to reorder the list (and rack)\n\n[Open Rack](command:chuckLive.openRack)\n\n[Open Sequencer](command:chuckLive.openSequencer)\n\n[Mod Matrix](command:chuckLive.showWiring)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chuckLive.startVm",
          "when": "view == chuckLive.control",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.stopVm",
          "when": "view == chuckLive.control",
          "group": "navigation@2"
        },
        {
          "command": "chuckLive.refreshStatus",
          "when": "view == chuckLive.control",
          "group": "navigation@3"
        },
        {
          "command": "chuckLive.initProject",
          "when": "view == chuckLive.control",
          "group": "navigation@4"
        },
        {
          "command": "chuckLive.importBundledPatterns",
          "when": "view == chuckLive.control",
          "group": "navigation@5"
        },
        {
          "command": "chuckLive.generateVoiceSample",
          "when": "view == chuckLive.control",
          "group": "navigation@6"
        },
        {
          "command": "chuckLive.refreshKnobs",
          "when": "view == chuckLive.knobs",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.openRack",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.openSequencer",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@2"
        },
        {
          "command": "chuckLive.showWiring",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@3"
        },
        {
          "command": "chuckLive.refreshStatus",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@4"
        },
        {
          "command": "chuckLive.removeAll",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "chuckLive.replaceShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckUserShred",
          "group": "inline@1"
        },
        {
          "command": "chuckLive.removeShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckUserShred",
          "group": "inline@2"
        },
        {
          "command": "chuckLive.removeShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckManagedShred",
          "group": "inline@1"
        },
        {
          "command": "chuckLive.loadFavorite",
          "when": "view == chuckLive.control && viewItem == chuckFavorite",
          "group": "inline@1"
        },
        {
          "command": "chuckLive.reloadFavorite",
          "when": "view == chuckLive.control && viewItem == chuckFavoriteLoaded",
          "group": "inline@1"
        },
        {
          "command": "chuckLive.removeFavorite",
          "when": "view == chuckLive.control && viewItem =~ /^chuckFavorite/",
          "group": "inline@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "chuckLive.runShred",
          "when": "resourceLangId == chuck",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "chuckLive.addShred",
          "when": "editorLangId == chuck",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.replaceShred",
          "when": "editorLangId == chuck",
          "group": "navigation@2"
        },
        {
          "command": "chuckLive.toggleFavorite",
          "when": "editorLangId == chuck",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "chuckLive.addShred",
          "when": "editorLangId == chuck",
          "group": "chuckLive@1"
        },
        {
          "command": "chuckLive.replaceShred",
          "when": "editorLangId == chuck",
          "group": "chuckLive@2"
        },
        {
          "command": "chuckLive.toggleFavorite",
          "when": "editorLangId == chuck",
          "group": "chuckLive@3"
        }
      ]
    },
    "configuration": {
      "title": "ChucK Live",
      "properties": {
        "chuckLive.executable": {
          "type": "string",
          "default": "chuck",
          "description": "ChucK binary. Default \"chuck\" auto-uses bin/chuck-pw (pw-jack) when present; set an absolute path to override."
        },
        "chuckLive.otfPort": {
          "type": "number",
          "default": 8888,
          "description": "OTF TCP port for the listener VM"
        },
        "chuckLive.oscPort": {
          "type": "number",
          "default": 9000,
          "description": "UDP port for knob OSC messages (bridge.ck listens here)"
        },
        "chuckLive.meterPort": {
          "type": "number",
          "default": 9001,
          "description": "UDP port for VU meter peaks (meter.ck sends here)"
        },
        "chuckLive.vmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed when starting chuck --loop"
        },
        "chuckLive.saveBeforeAdd": {
          "type": "boolean",
          "default": true,
          "description": "Save the active editor before add/reload"
        },
        "chuckLive.initLibraryDir": {
          "type": "string",
          "default": "chuck",
          "description": "Default folder name when running ChucK: Init Project Library"
        },
        "chuckLive.edgeTtsExecutable": {
          "type": "string",
          "default": "edge-tts",
          "description": "edge-tts binary for ChucK: Generate Voice Sample. Use an absolute path if it is not on PATH (e.g. ~/.local/bin/edge-tts)."
        },
        "chuckLive.ffmpegExecutable": {
          "type": "string",
          "default": "ffmpeg",
          "description": "ffmpeg binary used to convert TTS audio to mono 44.1 kHz WAV for doom-vox.ck. Absolute path if not on PATH."
        },
        "chuckLive.edgeTtsVoice": {
          "type": "string",
          "default": "en-US-GuyNeural",
          "description": "Default edge-tts neural voice pre-selected in Generate Voice Sample (e.g. en-US-GuyNeural, en-US-ChristopherNeural)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node ./node_modules/typescript/lib/tsc.js -p ./",
    "watch": "node ./node_modules/typescript/lib/tsc.js -watch -p ./",
    "package": "node ./node_modules/typescript/lib/tsc.js -p ./ && node scripts/package-vsix.js",
    "install-local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
