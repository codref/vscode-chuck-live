{
  "name": "chuck-live",
  "displayName": "ChucK Live",
  "description": "Live coding for ChucK: VM control, shred load/unload, and annotated knobs over OSC",
  "version": "0.3.6",
  "publisher": "chuck-live",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:chuck",
    "onView:chuckLive.control",
    "onView:chuckLive.sessionShreds",
    "onView:chuckLive.knobs",
    "onView:chuckLive.sessionMeter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "chuck",
        "aliases": [
          "ChucK",
          "chuck"
        ],
        "extensions": [
          ".ck"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chuck",
        "scopeName": "source.chuck",
        "path": "./syntaxes/chuck.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[chuck]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": false
        },
        "editor.codeLens": true
      }
    },
    "commands": [
      {
        "command": "chuckLive.startVm",
        "title": "ChucK: Start VM",
        "icon": "$(play)"
      },
      {
        "command": "chuckLive.stopVm",
        "title": "ChucK: Stop VM",
        "icon": "$(debug-stop)"
      },
      {
        "command": "chuckLive.addShred",
        "title": "ChucK: Add Current File",
        "shortTitle": "Load",
        "icon": "$(add)"
      },
      {
        "command": "chuckLive.replaceShred",
        "title": "ChucK: Reload Shred",
        "shortTitle": "Reload",
        "icon": "$(sync)"
      },
      {
        "command": "chuckLive.runShred",
        "title": "ChucK: Load / Reload",
        "shortTitle": "Load",
        "icon": "$(run)"
      },
      {
        "command": "chuckLive.removeShred",
        "title": "ChucK: Remove Shred",
        "icon": "$(trash)"
      },
      {
        "command": "chuckLive.removeAll",
        "title": "ChucK: Remove All Shreds",
        "icon": "$(clear-all)"
      },
      {
        "command": "chuckLive.refreshStatus",
        "title": "ChucK: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "chuckLive.refreshKnobs",
        "title": "ChucK: Refresh Knobs",
        "icon": "$(refresh)"
      },
      {
        "command": "chuckLive.openRack",
        "title": "ChucK: Open Rack",
        "icon": "$(circuit-board)"
      },
      {
        "command": "chuckLive.openSequencer",
        "title": "ChucK: Open Sequencer",
        "icon": "$(grabber)"
      },
      {
        "command": "chuckLive.initProject",
        "title": "ChucK: Init Project Library",
        "icon": "$(folder-library)"
      },
      {
        "command": "chuckLive.initProjectForce",
        "title": "ChucK: Re-init Project Library (force)"
      },
      {
        "command": "chuckLive.showSession",
        "title": "ChucK: Show Session (Shreds + Meter)",
        "icon": "$(list-unordered)"
      }
    ],
    "keybindings": [
      {
        "command": "chuckLive.replaceShred",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "editorLangId == chuck"
      },
      {
        "command": "chuckLive.addShred",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorLangId == chuck"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chuckLive",
          "title": "ChucK Live",
          "icon": "media/chuck-icon.svg"
        },
        {
          "id": "chuckLiveSession",
          "title": "ChucK Session",
          "icon": "media/chuck-session-icon.svg"
        }
      ]
    },
    "views": {
      "chuckLive": [
        {
          "type": "webview",
          "id": "chuckLive.knobs",
          "name": "Knobs"
        }
      ],
      "chuckLiveSession": [
        {
          "id": "chuckLive.control",
          "name": "Control"
        },
        {
          "id": "chuckLive.sessionShreds",
          "name": "Shreds"
        },
        {
          "type": "webview",
          "id": "chuckLive.sessionMeter",
          "name": "Meter"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "chuckLive.control",
        "contents": "Start the ChucK VM, then add `.ck` files as shreds from the editor.\n\n[Start VM](command:chuckLive.startVm)\n\n[Init Project Library](command:chuckLive.initProject)\n\n**Knobs** for the active file stay under the **ChucK Live** activity icon."
      },
      {
        "view": "chuckLive.sessionShreds",
        "contents": "No shreds loaded yet.\n\n1. **Start VM** from **Control** above\n2. **Add Current File** (`Ctrl+Shift+.`) from a `.ck` editor\n3. **Reload** (`Ctrl+.`) or the inline sync icon to hot-swap a loaded shred\n4. Drag shreds to reorder the list (and rack)\n\n[Open Rack](command:chuckLive.openRack)\n\n[Open Sequencer](command:chuckLive.openSequencer)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chuckLive.startVm",
          "when": "view == chuckLive.control",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.stopVm",
          "when": "view == chuckLive.control",
          "group": "navigation@2"
        },
        {
          "command": "chuckLive.refreshStatus",
          "when": "view == chuckLive.control",
          "group": "navigation@3"
        },
        {
          "command": "chuckLive.initProject",
          "when": "view == chuckLive.control",
          "group": "navigation@4"
        },
        {
          "command": "chuckLive.refreshKnobs",
          "when": "view == chuckLive.knobs",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.openRack",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.openSequencer",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@2"
        },
        {
          "command": "chuckLive.refreshStatus",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@3"
        },
        {
          "command": "chuckLive.removeAll",
          "when": "view == chuckLive.sessionShreds",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "chuckLive.replaceShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckUserShred",
          "group": "inline@1"
        },
        {
          "command": "chuckLive.removeShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckUserShred",
          "group": "inline@2"
        },
        {
          "command": "chuckLive.removeShred",
          "when": "view == chuckLive.sessionShreds && viewItem == chuckManagedShred",
          "group": "inline@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "chuckLive.runShred",
          "when": "resourceLangId == chuck",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "chuckLive.addShred",
          "when": "editorLangId == chuck",
          "group": "navigation@1"
        },
        {
          "command": "chuckLive.replaceShred",
          "when": "editorLangId == chuck",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "chuckLive.addShred",
          "when": "editorLangId == chuck",
          "group": "chuckLive@1"
        },
        {
          "command": "chuckLive.replaceShred",
          "when": "editorLangId == chuck",
          "group": "chuckLive@2"
        }
      ]
    },
    "configuration": {
      "title": "ChucK Live",
      "properties": {
        "chuckLive.executable": {
          "type": "string",
          "default": "chuck",
          "description": "ChucK binary. Default \"chuck\" auto-uses bin/chuck-pw (pw-jack) when present; set an absolute path to override."
        },
        "chuckLive.otfPort": {
          "type": "number",
          "default": 8888,
          "description": "OTF TCP port for the listener VM"
        },
        "chuckLive.oscPort": {
          "type": "number",
          "default": 9000,
          "description": "UDP port for knob OSC messages (bridge.ck listens here)"
        },
        "chuckLive.meterPort": {
          "type": "number",
          "default": 9001,
          "description": "UDP port for VU meter peaks (meter.ck sends here)"
        },
        "chuckLive.vmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed when starting chuck --loop"
        },
        "chuckLive.saveBeforeAdd": {
          "type": "boolean",
          "default": true,
          "description": "Save the active editor before add/reload"
        },
        "chuckLive.initLibraryDir": {
          "type": "string",
          "default": "chuck",
          "description": "Default folder name when running ChucK: Init Project Library"
        }
      }
    }
  },
  "scripts": {
    "compile": "node ./node_modules/typescript/lib/tsc.js -p ./",
    "watch": "node ./node_modules/typescript/lib/tsc.js -watch -p ./",
    "package": "node ./node_modules/typescript/lib/tsc.js -p ./ && node scripts/package-vsix.js",
    "install-local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
